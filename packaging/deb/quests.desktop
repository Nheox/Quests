[Desktop Entry]
Type=Application
Name=Quests
GenericName=Quest tracker
Comment=A local-first gamified quest tracker for real life
Exec=quests %u
Icon=quests
Terminal=false
Categories=Office;ProjectManagement;
Keywords=quest;task;todo;habit;productivity;rpg;
StartupNotify=true
StartupWMClass=cl-nheox-quests-MainKt
Actions=capture;

[Desktop Action capture]
Name=Quick capture
Exec=quests --capture
